# Copy to .env.local and fill in. Never commit real values.

# Supabase project (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Bypasses Row Level Security: never expose it to the browser
# (no NEXT_PUBLIC_ prefix) and only use it from src/lib/supabase/admin.ts or scripts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL of the app, used to build auth email links (confirm / reset password).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: password for users created by `npm run seed:demo` (local projects only).
# SEED_DEMO_PASSWORD=BizFlowDemo2026
